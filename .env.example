# 复制为 .env 后按需修改；应用不会自动读取 .env。
# 本地可用 `set -a; . ./.env; set +a` 导入，生产由 systemd EnvironmentFile 加载。
# 注意：.env 只放在服务器上，不要提交到仓库。

# 必须改成随机长字符串；留空时会自动生成并保存到 instance/secret.key
SECRET_KEY=

# HTTPS 部署时设为 1，使会话 Cookie 只走加密连接
COOKIE_SECURE=1

# 班级空间名称与注册邀请码
SITE_NAME=青禾 · 计师班班级空间
INVITE_CODE=CLASS2026

# 首次初始化时创建的超级管理员。ADMIN_PASSWORD 只在数据库首次初始化时读取；
# 留空会自动生成随机密码并写入 instance/first-login.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SQLite 数据库位置。生产环境建议放在代码目录外，例如 /var/lib/classsite/classsite.db
CLASSSITE_DB=instance/classsite.db

# 资源库文件目录（不在 static 下）。生产环境同样建议放在代码目录外
CLASSSITE_UPLOADS=instance/uploads

# 备份目录与保留天数（deploy/backup.py 使用）
CLASSSITE_BACKUP_DIR=instance/backups
BACKUP_KEEP_DAYS=30
